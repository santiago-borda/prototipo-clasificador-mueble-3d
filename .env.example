# URL pública estable a la que apuntan los QR de /qr (ej.: https://mi-proyecto.vercel.app), sin "/" final.
# Los QR impresos quedan atados a esta URL: no cambies el nombre del proyecto en Vercel después de imprimirlos.
# Si queda vacía, se usa el origen de la página (window.location.origin).
# Se incorpora en el build: al cambiarla hay que redesplegar.
NEXT_PUBLIC_BASE_URL=

# Modelo de Sabrina (clienta de Casa Mueble). SOLO LOCAL: el .dae y la tabla de piezas están en la carpeta
# Sabrina/ (ignorada por git; titularidad y uso pendientes). Poné 1 en .env.local para registrarlo.
# Sin esta variable, o sin la carpeta, la app funciona solo con Olmo. No definirla en Vercel.
NEXT_PUBLIC_ENABLE_SABRINA=

# Importador de prueba (/importar). Solo en Vercel y en .env.local, nunca en el repo.
# Sin las dos, la app funciona como siempre (solo Olmo) y la escritura responde 503.
# BLOB_READ_WRITE_TOKEN lo crea Vercel al conectar el store de Blob (privado).
BLOB_READ_WRITE_TOKEN=
# Clave compartida de escritura (subir, listar, borrar). La guarda y la cambia solo el responsable del proyecto.
IMPORT_UPLOAD_KEY=
# Solo desarrollo: guarda en .import-data/ en vez de Blob (se ignora con NODE_ENV=production).
IMPORT_STORE=

# Base de datos local (S2, docs/spec-s2-base-de-datos.md). Sin valores por defecto en el código.
# PFG_DB_PASSWORD: clave de la base del contenedor (docker-compose.yml). Elegí una; va en .env, nunca en el repo.
# PFG_DB_PORT: puerto local del contenedor (5432 si queda vacía).
PFG_DB_PASSWORD=
PFG_DB_PORT=
# URL de la base para la app y los scripts: postgres://pfg:<PFG_DB_PASSWORD>@127.0.0.1:5432/pfg
# db:migrate y db:seed se niegan a correr si el host no es localhost ni 127.0.0.1 (BaseNoLocalError).
DATABASE_URL=
# URL de la base para las pruebas de contrato contra PostgreSQL. Vacía: esas pruebas se saltean y lo dicen.
TEST_DATABASE_URL=

# Integración con el ERP (contrato UCP v1; docs/spec-integracion-erp-minima.md v0.3). Sin ERP_WEB_ORIGEN, /erp/*,
# /api/erp/* y /api/trabajos responden 404 y la app funciona como siempre.
# POR DEFECTO: ERP SIMULADO (local, no llama a ningún servicio externo). Levantalo con `npm run erp:simulado`
# y abrí http://localhost:4010/anfitrion (por localhost, no por 127.0.0.1).
# PARA PASAR A QA: poné ERP_MODO=real, descomentá los valores de QA de abajo y comentá ERP_WEB_ORIGEN de simulado.
# Usar QA con tu usuario (login de desarrollo, token real) es U-erp-real: requiere aprobación del equipo.
# Las credenciales de las invitaciones de QA van solo al .env.local de cada uno: nunca al repo ni al chat.
# "simulado" (por defecto) o "real". Simulado no arranca con NODE_ENV=production; ignora ERP_ISSUER, ERP_API_URL y
# ERP_BLOB_ORIGENES y usa solo ERP_SIMULADO_URL (nunca llama al ERP real).
ERP_MODO=simulado
# URL del ERP simulado (npm run erp:simulado). Por defecto http://127.0.0.1:4010.
ERP_SIMULADO_URL=
# Origen exacto del frontend del ERP (frame-ancestors y mensajes del iframe). Uno solo, sin barra final ni comodines;
# con NODE_ENV=production, https. Queda fijo en el build (cabecera frame-ancestors): al cambiarlo, rebuild.
# Simulado: el origen del anfitrión simulado.
ERP_WEB_ORIGEN=http://localhost:4010
# --- Valores de QA (no son secretos). Para usarlos: ERP_MODO=real y estas líneas descomentadas. ---
# ERP_WEB_ORIGEN=https://erp-qa.casamueble.com.ar
# Issuer del Auth del ERP, con la barra final. El JWKS es {ERP_ISSUER}.well-known/jwks.
# ERP_ISSUER=https://erp-auth-api-qa.casamueble.com.ar/
# API del ERP. Hoy solo la usa el login de desarrollo (ERP_LOGIN_DIRECTO).
# ERP_API_URL=https://erp-api-qa.casamueble.com.ar
# Orígenes https de las URLs firmadas del modelo y del CSV, separados por coma. Vacía a propósito: Casa Mueble
# todavía no informó el host del blob (consulta 1 del 20/11). Vacía = POST /api/trabajos rechaza toda descarga (400).
# ERP_BLOB_ORIGENES=
# ------------------------------------------------------------------------------------------------------
# "habilitado" enciende /ingresar (login contra el ERP desde el servidor). Solo desarrollo: con NODE_ENV=production
# el servidor no arranca. Con el ERP real, usarlo es U-erp-real (aprobación del equipo).
ERP_LOGIN_DIRECTO=
# Opcionales: timeout por llamada saliente (8000 ms), tope del zip (20971520) y del CSV (5242880) en bytes.
ERP_TIMEOUT_MS=
ERP_ZIP_MAX_BYTES=
ERP_CSV_MAX_BYTES=
